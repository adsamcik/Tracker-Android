+        val snapshot = read.result as? AmbientCellReadResult.Snapshot ?: return MeasuredRadioHistoryRead(problems = setOf(
+            HistoryProblem(HistorySource.CELL, if (read.result == AmbientCellReadResult.DependencyOverflow)
