+	@Test
+	fun `saved ongoing provider count stays partial and follows corrections and retraction`() = runTest {
+		val throughTimeMs = DAY_END / 2L
+		val fingerprint = seedPublicAuthority(cursor().copy(
+			importedThroughTimeMs = throughTimeMs,
+			lastObservedAtMs = throughTimeMs,
+			updatedAtMs = throughTimeMs,
+		))
+		val initial = fact(10L, endTimeMs = throughTimeMs, authorizationFingerprint = fingerprint)
+		database.ambientStepsFactRevisionDao().insert(initial)
+		val expected = AmbientStepsHistoryValue.Partial(
+			10L, setOf(AmbientStepsHistoryCause.PARTIAL_COVERAGE),
+		)
+		val reader = historyRepository()
+		val first = reader.readRange(stepsRange()) as AmbientStepsHistoryRead.Snapshot
+		first.days.single().total shouldBe expected
+		first.days.single().inSession shouldBe emptyList()
+		first.days.single().betweenSession.count shouldBe null
+		// Cursor progress is still reported; it no longer discards already saved counts.
+		(statusQuery().read(AllDaySourceStatusRequest.Steps(stepsRange())) as AllDaySourceStatusRead.Steps)
+			.materializingDays shouldBe setOf(AmbientStepsStructuralDay(0L, "UTC"))
+		val numeric = database.withTransaction {
+			reader.readNumericRangeInCurrentTransaction(
+				stepsRange(), requireNotNull(database.sourceEvidenceStateDao().get()).revision,
+			)
+		} as AmbientStepsNumericRangeRead.Snapshot
+		numeric.days.single().total shouldBe expected
+
+		val corrected = signed(initial.copy(
+			semanticRevision = 2L,
+			mutationId = AmbientStepsFactIntegrity.mutationId(
+				initial.logicalFactId, 2L, AmbientStepsFactRevisionEntity.OPERATION_UPSERT,
+			),
+			stepCount = 12L,
+			appliedAtMs = throughTimeMs + 1L,
+		))
+		database.ambientStepsFactRevisionDao().insert(corrected)
+		val afterCorrection = reader.readRange(stepsRange()) as AmbientStepsHistoryRead.Snapshot
+		afterCorrection.days.single().total shouldBe expected.copy(count = 12L)
+		afterCorrection.days.single().factOrigins.single().correctionRevision shouldBe 2L
+
+		database.ambientStepsFactRevisionDao().insert(retract(corrected))
+		val afterRetraction = reader.readRange(stepsRange()) as AmbientStepsHistoryRead.Snapshot
+		afterRetraction.days.single().total shouldBe AmbientStepsHistoryValue.Unavailable(
+			setOf(AmbientStepsHistoryCause.MATERIALIZING),
+		)
+		afterRetraction.days.single().factOrigins shouldBe emptyList()
+	}
+
+	@Test
+	fun `ongoing provider day does not hide an exact previous day in the same snapshot`() = runTest {
+		val throughTimeMs = DAY_END + DAY_END / 2L
+		val fingerprint = seedPublicAuthority(cursor().copy(
+			importedThroughTimeMs = throughTimeMs,
+			lastObservedAtMs = throughTimeMs,
+			updatedAtMs = throughTimeMs,
+		))
+		database.ambientStepsFactRevisionDao().insert(fact(10L, authorizationFingerprint = fingerprint))
+		database.ambientStepsFactRevisionDao().insert(fact(
+			20L, DAY_END, throughTimeMs, epochDay = 1L, authorizationFingerprint = fingerprint,
+		))
+		val read = historyRepository().readRange(AmbientStepsHistoryRangeRequest(listOf(
+			AmbientStepsStructuralDay(0L, "UTC"), AmbientStepsStructuralDay(1L, "UTC"),
+		))) as AmbientStepsHistoryRead.Snapshot
+		read.days.map { it.total } shouldBe listOf(
+			AmbientStepsHistoryValue.Exact(10L),
+			AmbientStepsHistoryValue.Partial(20L, setOf(AmbientStepsHistoryCause.PARTIAL_COVERAGE)),
+		)
+	}
