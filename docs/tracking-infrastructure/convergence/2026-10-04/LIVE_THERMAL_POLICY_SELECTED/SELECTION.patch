+			it.maximumReportLatencyMicros shouldBe 60_000_000
+			it.aggregationWindowMs shouldBe 60_000L
+		}
+		(hot.plans.getValue(SourceKind.STEPS) as StepsPlan).copy(revision = 0) shouldBe
+			(initial.plans.getValue(SourceKind.STEPS) as StepsPlan).copy(revision = 0)
+		descriptor.catalogReconfigurationDebt shouldBe null
+		descriptor.appliedSourcePlanIdentity shouldBe descriptor.desiredSourcePlanIdentity
+		subject.reconfigure(thermal) shouldBe SourceSessionReconfigureOutcome.Unchanged
+
+		subject.reconfigure(baseline).shouldBeInstanceOf<SourceSessionReconfigureOutcome.Applied>()
+		val cooled = requests.last().plan
