+			val seeds = database.nativePortableOwnerSeeds(ACTIVITY_SOURCE, identities, MAX_ACTIVITY_HISTORY_RESULTS)
+			when (val selected = selectBySegmentIdsInTransaction(seeds.map(SessionSegment::id))) {
