+			db.query("SELECT raw_identity FROM native_portable_ownership").use {
+				it.moveToFirst() shouldBe true
+				it.getString(0) shouldBe "logical"
+				it.moveToNext() shouldBe false
+			}
+		} finally {
+			helper.close()
+			room.close()
+		}
+	}
+}
