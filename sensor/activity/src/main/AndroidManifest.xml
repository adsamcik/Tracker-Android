<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="${applicationId}.permission.TRACKER" />

    <application>
        <activity
            android:name="com.adsamcik.tracker.activity.ui.SessionActivityActivityCompose"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".receiver.ActivityReceiver"
            android:exported="false"
            android:permission="com.google.android.gms.permission.ACTIVITY_RECOGNITION">
            <intent-filter>
                <action android:name="com.adsamcik.tracker.ACTIVITY_RESULT"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
