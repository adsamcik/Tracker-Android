    <!-- Advanced Settings Section -->
    <!-- Help Text for Advanced Settings -->
    <string name="help_min_distance">Tracker ootab, kuni olete nii kaugele liikunud, enne järgmise asukoha salvestamist. Väiksemad väärtused = detailsemad marsruudid, kuid suurem akukulu.</string>
    <string name="help_min_time">Kui sageli Tracker teie asukohta kontrollib. Väiksemad väärtused = sagedasemad uuendused, kuid suurem akukulu.</string>
    <string name="help_required_accuracy">GPS-i täpsuse lävi. Tracker eirab asukohauuendusi, mille täpsus on sellest väärtusest halvem. Väiksem väärtus = täpsem, kuid halva GPS-i korral võidakse uuendusi vahele jätta.</string>
    <string name="help_transition_detection">Tracker alustab ja peatab automaatselt teie liikumise põhjal. Kasutab vähem akut kui pidev GPS, kuid võib tegevuse muutuste tuvastamist edasi lükata.</string>
