    <string name="settings_sailing_detection_title">Détection de la navigation</string>
    <string name="settings_sailing_detection_summary">Détecte automatiquement la navigation à voile ou en bateau grâce à la vitesse GPS et adapte le suivi GPS en conséquence. Basé uniquement sur la vitesse — peut aussi se déclencher pour des activités de vitesse similaire comme le vélo.</string>
    <string name="settings_plane_detection_title">Détection des vols</string>
