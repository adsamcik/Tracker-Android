    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Matkat</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Toistuvat matkat usein käymiesi paikkojen välillä muodostavat kaarevia tähtikuvioita. Vakaa kaari näyttää jokaisen reitin, jota pitkin kulkee komeetta; paksummat kaaret tarkoittavat, että teit matkan useammin.</string>
