    <string name="map_layer_signal_coverage_chip">Katvealueet</string>
    <string name="map_layer_signal_coverage_description">Korostaa kohdat, joissa matkapuhelinsignaalisi oli heikko tai puuttui. Mitä punaisempi alue on, sitä heikompi peitto; hyvin peitetyt alueet pysyvät kirkkaina.</string>
