    <string name="map_layer_fog_chip">Sumu</string>
    <string name="map_layer_fog_description">Maailma nousee sumusta: jokainen koskettamasi alue paljastuu ja hohtaa sitä kirkkaammin, mitä perusteellisemmin siihen tutustuit. Paikat, joiden läpi vain kuljit, jäävät himmeäksi usvaksi; syvästi tutkimasi alue hohtaa kiinteän kullanvärisenä. Tutkimaton maa pysyy pimeänä.</string>
    <string name="map_layer_fog_faint">Kuljettu läpi</string>
    <string name="map_layer_fog_known">Hyvin tutkittu</string>
    <string name="map_layer_first_contact_title">Ensikosketus</string>
    <string name="map_layer_first_contact_chip">Löytö</string>
    <string name="map_layer_first_contact_description">Löytöjesi aikajana: jokainen alue väritetään sen mukaan, kuinka äskettäin astuit siellä ensi kerran. Kauan sitten löytämäsi paikat haalistuvat syvän indigonsinisiksi, kun taas tällä viikolla löytämäsi maa hohtaa kirkkaan syaanina — lue tutkimusretkesi tarina uusimpia rajoja kohti.</string>
