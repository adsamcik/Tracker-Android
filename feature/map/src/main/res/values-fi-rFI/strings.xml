    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Signaaliaurora</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Revontuli</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Mobiilisignaali esitetään auroran kaltaisena hohteena: kirkkaan syaaninvihreän ytimen alla on laaja violetti kehä. Hohto sykkii ilman tietojen uudelleenlatausta ja muuttuu staattiseksi, kun järjestelmän animaatiot on poistettu käytöstä.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Heikko signaali</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Voimakas signaali</string>
    <string name="map_layer_speed_heatmap_description">Lämpökartta, joka kuvaa liikkumisnopeutta eri alueilla.</string>
