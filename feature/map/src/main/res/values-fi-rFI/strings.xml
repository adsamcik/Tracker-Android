    <string name="map_layer_legacy_heatmap_title">Vanha lämpökartta</string>
    <string name="map_layer_legacy_heatmap_chip">Vanhat ruudut</string>
    <string name="map_layer_legacy_heatmap_description">Paluu alkuperäiseen Signals-sovellukseen: sijaintitiheytesi piirretään erillisinä 25 m:n ruutuina, kuten lämpökartta näytti, kun ruudut hahmonnettiin palvelimella. Lähennä nähdäksesi neliöt.</string>
    <string name="map_layer_seasonal_title">Vuodenaikojen tutkija</string>
    <string name="map_layer_seasonal_chip">Vuodenajat</string>
    <string name="map_layer_seasonal_description">Vuodenaikamuistojen tilkkutäkki: jokainen tutkimasi alue sävytetään sen mukaan, minä vuodenaikana kävit siellä ensimmäisen kerran. Etsi polut, joilla kävelet vain kesällä, tai kadut, jotka näet vain talvella.</string>
    <string name="map_layer_season_spring">Kevät</string>
    <string name="map_layer_season_summer">Kesä</string>
    <string name="map_layer_season_autumn">Syksy</string>
    <string name="map_layer_season_winter">Talvi</string>
    <string name="map_layer_terrain_title">Elämä maastona</string>
    <string name="map_layer_terrain_chip">Maasto</string>
    <string name="map_layer_terrain_description">Sijaintitiheytesi kohoaa 3D-muotoon: paikat, joissa vietät eniten aikaa, nousevat korkeiksi hohtaviksi pöytävuoriksi, kun taas kertaluonteiset paikat pysyvät matalina. Kallista karttaa nähdäksesi elämäsi reliefin.</string>
    <string name="map_layer_terrain_low">Harvoin täällä</string>
    <string name="map_layer_terrain_mid">Joskus</string>
    <string name="map_layer_terrain_high">Usein täällä</string>
    <string name="map_layer_places_title">Usein käydyt paikat</string>
    <string name="map_layer_places_chip">Paikat</string>
    <string name="map_layer_places_description">Tärkeät paikkasi näkyvät merkkeinä, joiden koko ja väri kertovat käyntitiheydestä. Koti ja työ kasvavat suuriksi lämpimiksi pisteiksi; kerran käymäsi paikka jää pieneksi viileäksi pisteeksi.</string>
    <string name="map_layer_places_rare">Harvoin</string>
    <string name="map_layer_places_often">Joskus</string>
    <string name="map_layer_places_anchor">Tukikohtasi</string>
    <string name="map_layer_speed_ribbon_title">Nopeusnauha</string>
    <string name="map_layer_speed_ribbon_chip">Nauha</string>
    <string name="map_layer_speed_ribbon_description">Reittisi on maalattu liikkumisnopeutesi mukaan: väri kulkee hitaasta violetista kävelystä punakuumaan juoksuun tai ajoon. Toisin kuin nopeuslämpökartta, nauha säilyttää reittisi ehjänä, joten näet tarkasti, missä kiihdytit ja hidastit.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Korkeusnauha</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Korkeus</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Reittisi on maalattu absoluuttisen korkeuden mukaan: syvänsinisistä alangoista syaanien esivuorten kautta lämpimiin vuoristokorkeuksiin. Asteikko pysyy samana karttaa siirtäessäsi, joten samalla korkeudella on aina sama väri.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Alangot</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Esivuoret</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Korkeat vuoret</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Aktiivisuusnauha</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktiivisuus</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Reittisi on maalattu jokaisen korjauksen yhteydessä tallennetun luotettavan liiketilan mukaan: harmaalla, kun tila oli tuntematon, sinisellä paikallaan ollessa ja vihreällä liikkuessa.</string>
