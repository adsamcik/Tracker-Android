    <string name="map_layer_terrain_chip">Maastik</string>
    <string name="map_layer_terrain_description">Teie asukohatihedus tõstetud 3D-sse: kohad, kus veedate kõige rohkem aega, kerkivad kõrgete helendavate platoodena, üksikkohad jäävad madalaks. Kallutage kaarti, et näha oma elu reljeefi.</string>
    <string name="map_layer_terrain_low">Harva siin</string>
