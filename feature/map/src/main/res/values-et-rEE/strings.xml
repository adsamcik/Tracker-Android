    <string name="map_layer_places_chip">Kohad</string>
    <string name="map_layer_places_description">Teie olulised kohad markeritena, mille suurus ja värv sõltuvad külastussagedusest. Kodu ja töö muutuvad suurteks soojadeks punktideks; üks kord külastatud koht jääb väikeseks ja jahedaks.</string>
