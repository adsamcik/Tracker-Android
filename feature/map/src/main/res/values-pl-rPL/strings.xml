    <string name="description_map_search">Przycisk wyszukiwania na mapie</string>
    <string name="map_layer_cell_heatmap_description">Zaobserwowany krajobraz sieci komórkowej według technologii radiowej. Delikatne pola pokazują, gdzie docierały komórki obsługujące; świecące środki są ostrożnymi szacunkami lokalizacji stacji i stają się wyraźniejsze dopiero wtedy, gdy otaczają je obserwacje.</string>
    <string name="map_layer_cell_heatmap_title">Topologia sieci komórkowej</string>
    <string name="map_layer_location_heatmap_high">Duża gęstość</string>
    <string name="map_layer_location_heatmap_low">Mała gęstość</string>
    <string name="map_layer_location_heatmap_low_medium" translatable="false">Low-medium density</string>
    <string name="map_layer_location_heatmap_medium">Średnia gęstość</string>
    <string name="map_layer_location_heatmap_peak" translatable="false">Peak density</string>
    <string name="map_layer_distinct_visits_title" tools:ignore="MissingTranslation">Różne odwiedziny</string>
    <string name="map_layer_distinct_visits_chip" tools:ignore="MissingTranslation">Odwiedziny</string>
    <string name="map_layer_distinct_visits_description" tools:ignore="MissingTranslation">Względna gęstość zaakceptowanych ustaleń lokalizacji. Pokazuje różne obserwacje, a nie spędzony czas.</string>
    <string name="map_layer_cell_radio_gsm">Zasięg GSM</string>
    <string name="map_layer_cell_radio_wcdma">3G / WCDMA</string>
    <string name="map_layer_cell_radio_lte">4G / LTE</string>
    <string name="map_layer_cell_radio_nr">5G / NR</string>
    <string name="map_layer_signal_coverage_title">Martwe strefy sygnału</string>
    <string name="map_layer_signal_coverage_chip" translatable="false">Dead zones</string>
    <string name="map_layer_signal_coverage_description">Wyróżnia miejsca, gdzie sygnał sieci komórkowej był słaby lub nieobecny. Im bardziej czerwony obszar, tym gorszy zasięg; dobrze pokryte obszary pozostają przejrzyste.</string>
    <string name="map_layer_signal_coverage_weak" translatable="false">Weak</string>
    <string name="map_layer_signal_coverage_poor" translatable="false">Poor</string>
    <string name="map_layer_signal_coverage_very_poor" translatable="false">Very poor</string>
    <string name="map_layer_signal_coverage_dead" translatable="false">Dead zone</string>
    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Zorza sygnału</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Zorza</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Sygnał sieci komórkowej renderowany jako blask podobny do zorzy: szeroka fioletowa poświata pod jasnym cyjanowo-zielonym rdzeniem. Poświata pulsuje bez ponownego ładowania danych i staje się statyczna, gdy animacje systemowe są wyłączone.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Słaby sygnał</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Silny sygnał</string>
    <string name="map_layer_speed_heatmap_description">Mapa cieplna przedstawiająca prędkość ruchu w różnych obszarach.</string>
    <string name="map_layer_speed_very_slow">Bardzo wolno</string>
    <string name="map_layer_speed_walking">Tempo chodu</string>
    <string name="map_layer_speed_running">Tempo biegu</string>
    <string name="map_layer_speed_moderate">Umiarkowana prędkość</string>
    <string name="map_layer_speed_fast">Szybki ruch</string>
    <string name="map_layer_speed_very_fast">Bardzo szybko</string>
    <string name="map_layer_speed_heatmap_title">Mapa cieplna prędkości</string>
    <string name="map_layer_legacy_heatmap_title">Starsza mapa cieplna</string>
    <string name="map_layer_legacy_heatmap_chip">Starsze kafelki</string>
    <string name="map_layer_legacy_heatmap_description">Powrót do oryginalnej aplikacji Signals: gęstość lokalizacji rysowana jako osobne kafelki siatki 25 m, tak jak mapa cieplna wyglądała, gdy kafelki były renderowane na serwerze. Przybliż mapę, aby zobaczyć kwadraty.</string>
    <string name="map_layer_seasonal_title">Odkrywca pór roku</string>
    <string name="map_layer_seasonal_chip">Pory roku</string>
    <string name="map_layer_seasonal_description">Mozaika sezonowych wspomnień: każdy odkryty obszar jest zabarwiony porą roku, w której odwiedzono go po raz pierwszy. Znajdź szlaki, po których chodzisz tylko latem, albo ulice widywane tylko zimą.</string>
    <string name="map_layer_season_spring">Wiosna</string>
    <string name="map_layer_season_summer">Lato</string>
    <string name="map_layer_season_autumn">Jesień</string>
    <string name="map_layer_season_winter">Zima</string>
    <string name="map_layer_terrain_title">Życie jako teren</string>
    <string name="map_layer_terrain_chip">Teren</string>
    <string name="map_layer_terrain_description">Gęstość lokalizacji uniesiona do 3D: miejsca, w których spędzasz najwięcej czasu, wyrastają jako wysokie świecące płaskowyże, a odwiedzane jednorazowo pozostają niskie. Przechyl mapę, aby zobaczyć rzeźbę swojego życia.</string>
    <string name="map_layer_terrain_low">Rzadko tutaj</string>
    <string name="map_layer_terrain_mid">Czasami</string>
    <string name="map_layer_terrain_high">Często tutaj</string>
    <string name="map_layer_places_title">Często odwiedzane miejsca</string>
    <string name="map_layer_places_chip">Miejsca</string>
    <string name="map_layer_places_description">Ważne miejsca jako znaczniki, których rozmiar i kolor zależą od częstotliwości odwiedzin. Dom i praca stają się dużymi ciepłymi punktami; miejsce odwiedzone raz pozostaje małe i chłodne.</string>
    <string name="map_layer_places_rare">Rzadko</string>
    <string name="map_layer_places_often">Czasami</string>
    <string name="map_layer_places_anchor">Twoje punkty odniesienia</string>
    <string name="map_layer_speed_ribbon_title">Wstęga prędkości</string>
    <string name="map_layer_speed_ribbon_chip">Wstęga</string>
    <string name="map_layer_speed_ribbon_description">Trasa malowana według szybkości ruchu, płynnym kolorem od powolnego fioletowego spaceru do czerwonego sprintu lub jazdy. W przeciwieństwie do mapy cieplnej prędkości wstęga zachowuje przebieg ścieżki, więc dokładnie widać, gdzie nastąpiło przyspieszenie i zwolnienie.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Wstęga wysokości</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Wysokość</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Trasa malowana bezwzględną wysokością, od głębokich niebieskich nizin przez cyjanowe pogórza po ciepłe wysokości gór. Skala pozostaje stała podczas przesuwania mapy, więc ta sama wysokość zawsze ma ten sam kolor.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Niziny</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Pogórze</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Wysokie góry</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Wstęga aktywności</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktywność</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Trasa malowana wiarygodnym stanem ruchu zapisanym przy każdym ustaleniu: szara, gdy stan jest nieznany, niebieska w bezruchu i zielona podczas ruchu.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Nieznana</string>
    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Bez ruchu</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">W ruchu</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">Prześwietlenie narciarskie</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Prześwietlenie nart</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Widok diagnostyczny wykrytych odcinków narciarskich. Zjazdy, wyciągi, spacery i przerwy są zakotwiczone przy najbliższej zarejestrowanej lokalizacji i oznaczone kluczowymi metrykami.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Zjazd</string>
    <string name="map_layer_ski_lift" tools:ignore="MissingTranslation">Wyciąg</string>
    <string name="map_layer_ski_walk" tools:ignore="MissingTranslation">Spacer lub przerwa</string>
    <string name="map_layer_trip_constellations_title" tools:ignore="MissingTranslation">Konstelacje podróży</string>
    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Podróże</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Powtarzające się podróże między często odwiedzanymi miejscami stają się zakrzywionymi konstelacjami. Stabilny łuk pokazuje każdą trasę, a kometa przesuwa się po nim; grubsze łuki oznaczają częstsze podróże.</string>
    <string name="map_layer_trip_walk" tools:ignore="MissingTranslation">Chodzenie</string>
    <string name="map_layer_trip_bike" tools:ignore="MissingTranslation">Jazda na rowerze</string>
    <string name="map_layer_trip_car" tools:ignore="MissingTranslation">Jazda samochodem</string>
    <string name="map_layer_trip_transit" tools:ignore="MissingTranslation">Transport publiczny</string>
    <string name="map_layer_trip_other" tools:ignore="MissingTranslation">Inne</string>
    <string name="map_layer_fog_title">Mgła odkrywcy</string>
    <string name="map_layer_fog_chip">Mgła</string>
    <string name="map_layer_fog_description">Świat wyłaniający się z mgły: każdy odwiedzony obszar zostaje odkryty i świeci jaśniej, im dokładniej go poznano. Miejsca, przez które tylko przechodzisz, pozostają delikatną mgiełką; głęboko odkryty obszar płonie pełnym złotem. Nieodkryty teren pozostaje ciemny.</string>
    <string name="map_layer_fog_faint">Przebyto</string>
    <string name="map_layer_fog_known">Dobrze zbadane</string>
    <string name="map_layer_first_contact_title">Pierwszy kontakt</string>
    <string name="map_layer_first_contact_chip">Odkrycie</string>
    <string name="map_layer_first_contact_description">Oś czasu odkryć: każdy obszar jest zabarwiony według tego, jak dawno po raz pierwszy tam dotarto. Miejsca odkryte dawno temu bledną do głębokiego indygo, a tereny odkryte w tym tygodniu świecą jasnym cyjanem — poznaj historię odkrywania aż po najnowsze granice.</string>
    <string name="map_layer_first_contact_old">Dawno temu</string>
    <string name="map_layer_first_contact_recent">Właśnie odkryte</string>
    <string name="map_layer_vehicle_compliance_title">Zgodność prędkości pojazdu</string>
    <string name="map_layer_vehicle_compliance_description">Polilinia próbek jazdy zabarwiona według porównania prędkości ze skonfigurowanym limitem bazowym.</string>
    <string name="map_layer_vehicle_compliance_way_under">Znacznie poniżej limitu</string>
