    <string name="map_layer_distinct_visits_title" tools:ignore="MissingTranslation">Distinct visits</string>
    <string name="map_layer_distinct_visits_chip" tools:ignore="MissingTranslation">Visits</string>
    <string name="map_layer_distinct_visits_description" tools:ignore="MissingTranslation">Relative density of accepted location fixes. This shows distinct observations, not time spent.</string>
