    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Resor</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Återkommande resor mellan dina vanliga platser blir böjda konstellationer. En stabil båge visar varje rutt medan en komet färdas längs den; tjockare bågar betyder att du gjorde resan oftare.</string>
