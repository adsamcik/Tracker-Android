    <string name="map_layer_speed_fast">Snabb rörelse</string>
    <string name="map_layer_speed_very_fast">Mycket snabb</string>
    <string name="map_layer_speed_heatmap_title">Hastighetsvärmekarta</string>
    <string name="map_layer_legacy_heatmap_title">Äldre värmekarta</string>
    <string name="map_layer_legacy_heatmap_chip">Äldre brickor</string>
    <string name="map_layer_legacy_heatmap_description">En hyllning till den ursprungliga Signals-appen: din platstäthet ritad som diskreta 25 m-rutbrickor, så som värmekartan såg ut när brickorna återgavs på servern. Zooma in för att se rutorna.</string>
    <string name="map_layer_seasonal_title">Säsongsutforskare</string>
    <string name="map_layer_seasonal_chip">Säsonger</string>
    <string name="map_layer_seasonal_description">Ett lapptäcke av säsongsminnen: varje område du har utforskat färgas av den säsong då du först besökte det. Hitta stigarna du bara går på på sommaren eller gatorna du bara ser på vintern.</string>
    <string name="map_layer_season_spring">Vår</string>
    <string name="map_layer_season_summer">Sommar</string>
    <string name="map_layer_season_autumn">Höst</string>
    <string name="map_layer_season_winter">Vinter</string>
    <string name="map_layer_terrain_title">Livet som terräng</string>
    <string name="map_layer_terrain_chip">Terräng</string>
    <string name="map_layer_terrain_description">Din platstäthet upphöjd till 3D: platser där du tillbringar mest tid reser sig som höga lysande platåer, medan platser du bara besöker en gång ligger lågt. Luta kartan för att se ditt livs relief.</string>
    <string name="map_layer_terrain_low">Sällan här</string>
    <string name="map_layer_terrain_mid">Ibland</string>
    <string name="map_layer_terrain_high">Ofta här</string>
    <string name="map_layer_places_title">Vanliga platser</string>
    <string name="map_layer_places_chip">Platser</string>
    <string name="map_layer_places_description">Dina viktiga platser som markörer, där storlek och färg visar hur ofta du besöker dem. Hem och arbete blir stora varma punkter; en plats du besökt en gång förblir liten och sval.</string>
    <string name="map_layer_places_rare">Sällan</string>
    <string name="map_layer_places_often">Ibland</string>
    <string name="map_layer_places_anchor">Dina ankare</string>
    <string name="map_layer_speed_ribbon_title">Hastighetsband</string>
    <string name="map_layer_speed_ribbon_chip">Band</string>
    <string name="map_layer_speed_ribbon_description">Din rutt målad efter hur snabbt du rörde dig, med flytande färg från en långsam violett promenad till en rödglödande sprint eller bilfärd. Till skillnad från hastighetsvärmekartan håller bandet din väg samman så att du ser exakt var du ökade och minskade farten.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Höjdband</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Höjd</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Din rutt målad efter absolut höjd, från djupblå lågland via cyanblå fotberg till varma bergshöjder. Skalan förblir fast när du panorerar, så samma höjd behåller alltid samma färg.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Lågland</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Fotberg</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Höga berg</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Aktivitetsband</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktivitet</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Din rutt målad efter det tillförlitliga rörelsetillstånd som registrerades med varje position: grå där tillståndet var okänt, blå när du stod stilla och grön medan du rörde dig.</string>
