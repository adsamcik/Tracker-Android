    <string name="map_layer_fog_known">Väl utforskat</string>
    <string name="map_layer_first_contact_title">Första kontakt</string>
    <string name="map_layer_first_contact_chip">Upptäckt</string>
    <string name="map_layer_first_contact_description">En tidslinje över dina upptäckter: varje område färgas av hur nyligen du först satte din fot där. Platser du hittade för länge sedan tonar mot djup indigo, medan mark du bröt ny på denna vecka lyser klart cyan — läs din utforskningshistoria ut mot de nyaste gränserna.</string>
