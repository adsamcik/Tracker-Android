    <string name="map_layer_signal_coverage_title">Hluché miesta signálu</string>
    <string name="map_layer_signal_coverage_chip" translatable="false">Dead zones</string>
    <string name="map_layer_signal_coverage_description">Zvýrazňuje miesta, kde bol mobilný signál slabý alebo chýbal. Čím je oblasť červenšia, tým je pokrytie horšie; dobre pokryté oblasti zostávajú čisté.</string>
