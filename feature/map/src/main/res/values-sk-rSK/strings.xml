    <string name="map_layer_wifi_count_heatmap_title">Prekrytie Wi-Fi</string>
    <string name="map_layer_wifi_count_heatmap_description">Zobrazuje, koľko jedinečných prístupových bodov sa prekrýva na každom mieste. Opakované skenovania rovnakého AP sa počítajú raz, preto teplejšie oblasti znamenajú naozaj hustejšie rádiové pokrytie.</string>
    <string name="map_layer_wifi_heatmap_description">Konštelácia Wi-Fi podľa pásiem z vašich vlastných pozorovaní. Farebné polia zobrazujú pozorované pokrytie 2,4, 5 a 6 GHz; žiariace stredy sú približné polohy AP zobrazené iba vtedy, keď ich podporuje geometria vzoriek.</string>
    <string name="map_layer_wifi_heatmap_high">Mnoho prekrývajúcich sa AP</string>
