    <string name="map_layer_signal_coverage_dead" translatable="false">Dead zone</string>
    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Polárna žiara signálu</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Polárna žiara</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Bunkový signál vykreslený ako žiara polárnej žiary: široké fialové halo pod jasným azúrovo-zeleným jadrom. Žiara pulzuje bez opätovného načítania údajov a pri vypnutých systémových animáciách sa zastaví.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Slabý signál</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Silný signál</string>
    <string name="map_layer_speed_heatmap_description">Teplotná mapa znázorňujúca rýchlosť pohybu v rôznych oblastiach.</string>
    <string name="map_layer_speed_very_slow">Veľmi pomalý</string>
    <string name="map_layer_speed_walking">Tempo chôdze</string>
    <string name="map_layer_speed_running">Tempo behu</string>
    <string name="map_layer_speed_moderate">Stredná rýchlosť</string>
    <string name="map_layer_speed_fast">Rýchly pohyb</string>
    <string name="map_layer_speed_very_fast">Veľmi rýchly</string>
    <string name="map_layer_speed_heatmap_title">Teplotná mapa rýchlosti</string>
    <string name="map_layer_legacy_heatmap_title">Pôvodná teplotná mapa</string>
    <string name="map_layer_legacy_heatmap_chip">Pôvodné dlaždice</string>
    <string name="map_layer_legacy_heatmap_description">Návrat k pôvodnej aplikácii Signals: hustota vašej polohy vykreslená ako samostatné dlaždice mriežky s veľkosťou 25 m, ako vyzerala teplotná mapa pri vykresľovaní dlaždíc na serveri. Priblížením zobrazíte štvorce.</string>
    <string name="map_layer_seasonal_title">Sezónny prieskumník</string>
    <string name="map_layer_seasonal_chip">Ročné obdobia</string>
    <string name="map_layer_seasonal_description">Mozaika sezónnych spomienok: každá oblasť, ktorú ste objavili, je zafarbená ročným obdobím vašej prvej návštevy. Nájdite chodníky, po ktorých chodíte iba v lete, alebo ulice, ktoré vidíte len v zime.</string>
    <string name="map_layer_season_spring">Jar</string>
    <string name="map_layer_season_summer">Leto</string>
    <string name="map_layer_season_autumn">Jeseň</string>
    <string name="map_layer_season_winter">Zima</string>
    <string name="map_layer_terrain_title">Život ako terén</string>
    <string name="map_layer_terrain_chip">Terén</string>
    <string name="map_layer_terrain_description">Hustota vašej polohy premenená na 3D: miesta, kde trávite najviac času, vystupujú ako vysoké žiariace stolové hory, zatiaľ čo jednorazové miesta zostávajú nízke. Nakloňte mapu a uvidíte reliéf svojho života.</string>
    <string name="map_layer_terrain_low">Zriedka tu</string>
    <string name="map_layer_terrain_mid">Niekedy</string>
    <string name="map_layer_terrain_high">Často tu</string>
    <string name="map_layer_places_title">Časté miesta</string>
    <string name="map_layer_places_chip">Miesta</string>
    <string name="map_layer_places_description">Vaše dôležité miesta ako značky, pričom ich veľkosť a farba závisia od frekvencie návštev. Domov a práca sa stanú veľkými teplými bodmi; miesto navštívené raz zostane malým chladným bodom.</string>
    <string name="map_layer_places_rare">Zriedka</string>
    <string name="map_layer_places_often">Niekedy</string>
    <string name="map_layer_places_anchor">Vaše kotvy</string>
    <string name="map_layer_speed_ribbon_title">Stuha rýchlosti</string>
    <string name="map_layer_speed_ribbon_chip">Stuha</string>
    <string name="map_layer_speed_ribbon_description">Vaša trasa je zafarbená podľa rýchlosti pohybu, s plynulou farbou od pomalej fialovej chôdze po červený šprint alebo jazdu. Na rozdiel od teplotnej mapy rýchlosti stuha zachováva vašu trasu, takže presne vidíte, kde ste zrýchlili a spomalili.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Výšková stuha</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Nadmorská výška</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Vaša trasa je zafarbená podľa absolútnej nadmorskej výšky, od tmavomodrých nížin cez azúrové predhorie po teplé horské výšky. Mierka ostáva pri posúvaní pevná, takže rovnaká výška má vždy rovnakú farbu.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Nížiny</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Predhorie</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Vysoké hory</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Stuha aktivity</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktivita</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Vaša trasa je zafarbená podľa spoľahlivého stavu pohybu zaznamenaného pri každom určení polohy: sivá pri neznámom stave, modrá pri nehybnosti a zelená pri pohybe.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Neznáme</string>
    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Bez pohybu</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">Pohyb</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">Lyžiarsky röntgen</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Lyžiarsky röntgen</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Diagnostické zobrazenie rozpoznaných lyžiarskych úsekov. Zjazdy, vleky, chôdza a prestávky sú ukotvené k najbližšej zaznamenanej polohe a označené kľúčovými metrikami.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Zjazd</string>
    <string name="map_layer_ski_lift" tools:ignore="MissingTranslation">Vlek</string>
    <string name="map_layer_ski_walk" tools:ignore="MissingTranslation">Chôdza alebo prestávka</string>
    <string name="map_layer_trip_constellations_title" tools:ignore="MissingTranslation">Súhvezdia ciest</string>
    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Cesty</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Opakované cesty medzi častými miestami sa menia na zakrivené súhvezdia. Stabilný oblúk zobrazuje každú trasu, zatiaľ čo po ňom putuje kométa; hrubšie oblúky znamenajú častejšiu cestu.</string>
    <string name="map_layer_trip_walk" tools:ignore="MissingTranslation">Chôdza</string>
    <string name="map_layer_trip_bike" tools:ignore="MissingTranslation">Bicyklovanie</string>
    <string name="map_layer_trip_car" tools:ignore="MissingTranslation">Jazda autom</string>
    <string name="map_layer_trip_transit" tools:ignore="MissingTranslation">Verejná doprava</string>
    <string name="map_layer_trip_other" tools:ignore="MissingTranslation">Ostatné</string>
    <string name="map_layer_fog_title">Hmla prieskumníka</string>
    <string name="map_layer_fog_chip">Hmla</string>
    <string name="map_layer_fog_description">Svet vystupujúci z hmly: odhalí sa každá oblasť, ktorej ste sa dotkli, a tým jasnejšie žiari, čím dôkladnejšie ste ju spoznali. Miesta, ktorými ste len prešli, ostávajú slabým oparom; dôkladne objavené miesta žiaria plným zlatom. Neobjavená zem zostáva tmavá.</string>
    <string name="map_layer_fog_faint">Prešli ste tadiaľ</string>
    <string name="map_layer_fog_known">Dobre preskúmané</string>
    <string name="map_layer_first_contact_title">Prvý kontakt</string>
    <string name="map_layer_first_contact_chip">Objav</string>
    <string name="map_layer_first_contact_description">Časová os vašich objavov: každá oblasť je zafarbená podľa toho, ako nedávno ste tam prvýkrát vstúpili. Miesta nájdené dávno miznú do tmavého indiga, zatiaľ čo pôda objavená tento týždeň žiari jasnou azúrovou — čítajte príbeh svojho objavovania smerom k najnovším hraniciam.</string>
