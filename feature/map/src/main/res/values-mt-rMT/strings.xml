    <string name="map_layer_legacy_heatmap_title">Mappa termika klassika</string>
    <string name="map_layer_legacy_heatmap_chip">Madum klassiku</string>
    <string name="map_layer_legacy_heatmap_description">Tifkira tal-applikazzjoni Signals oriġinali: id-densità tal-post tiegħek miġbuda bħala madum diskret tal-gradilja ta’ 25 m, kif kienet tidher il-mappa termika meta l-madum kien jintwera fuq is-server. Żumja biex tara l-kwadri.</string>
    <string name="map_layer_seasonal_title">Esploratur tal-istaġuni</string>
    <string name="map_layer_seasonal_chip">Staġuni</string>
    <string name="map_layer_seasonal_description">Mużajk ta’ memorja staġjonali: kull żona li esplorajt tingħata kulur skont l-istaġun li żorthom l-ewwel fih. Sib il-mogħdijiet li timxi fihom biss fis-sajf, jew it-toroq li tara biss fix-xitwa.</string>
    <string name="map_layer_season_spring">Rebbiegħa</string>
    <string name="map_layer_season_summer">Sajf</string>
    <string name="map_layer_season_autumn">Ħarifa</string>
    <string name="map_layer_season_winter">Xitwa</string>
    <string name="map_layer_terrain_title">Ħajja bħala art</string>
    <string name="map_layer_terrain_chip">Art</string>
    <string name="map_layer_terrain_description">Id-densità tal-post tiegħek mtellgħa fi 3D: il-postijiet fejn tqatta’ l-aktar ħin jitilgħu bħala mesas għoljin jleqqu, waqt li postijiet iżolati jibqgħu baxxi. Mejjel il-mappa biex tara r-riljiev ta’ ħajtek.</string>
    <string name="map_layer_terrain_low">Rari hawn</string>
    <string name="map_layer_terrain_mid">Kultant</string>
    <string name="map_layer_terrain_high">Spiss hawn</string>
    <string name="map_layer_speed_ribbon_title">Żigarella tal-veloċità</string>
    <string name="map_layer_speed_ribbon_chip">Żigarella</string>
    <string name="map_layer_speed_ribbon_description">Ir-rotta tiegħek miżbugħa skont kemm kont miexi malajr, b’kulur li jgħaddi minn pass vjola bil-mod għal sprint jew sewqan aħmar jaħraq. B’differenza mill-mappa termika tal-veloċità, iż-żigarella żżomm il-mogħdija tiegħek intatta sabiex tara eżatt fejn aċċellerajt u naqqast.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Żigarella tal-altitudni</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Altitudni</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Ir-rotta tiegħek miżbugħa skont l-elevazzjoni assoluta, minn artijiet baxxi blu skuri sa għoljiet ċjan u għoli ta’ muntanji sħan. L-iskala tibqa’ fissa waqt li tiċċaqlaq fil-mappa, għalhekk l-istess altitudni dejjem iżżomm l-istess kulur.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Artijiet baxxi</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Għoljiet</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Muntanji għoljin</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Żigarella tal-attività</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Attività</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Ir-rotta tiegħek miżbugħa bl-istat ta’ moviment affidabbli rreġistrat ma’ kull fissazzjoni: griż fejn l-istat ma kienx magħruf, blu waqt li kont wieqaf, u aħdar waqt li kont miexi.</string>
