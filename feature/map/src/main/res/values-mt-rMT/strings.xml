    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Wieqaf</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">Jiċċaqlaq</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">X-ray tal-iskijjar</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">X-ray tal-iskijjar</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Veduta dijanjostika ta’ segmenti tal-iskijjar misjuba. Ġirjiet għan-niżla, liftijiet, mixjiet u pawżi huma marbuta mal-eqreb post irreġistrat u ttikkettati bil-metriċi ewlenin tagħhom.</string>
