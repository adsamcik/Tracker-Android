    <string name="map_layer_fog_title">Raziskovalčeva megla</string>
    <string name="map_layer_fog_chip">Megla</string>
    <string name="map_layer_fog_description">Svet, ki se dviga iz megle: razkrito je vsako območje, ki ste se ga dotaknili, in bolj ko ste ga spoznali, močneje žari. Kraji, skozi katere ste le šli, ostanejo rahel opar; globoko raziskani kraji žarijo v polnem zlatu. Neraziskana tla ostanejo temna.</string>
    <string name="map_layer_fog_faint">Skozi</string>
    <string name="map_layer_fog_known">Dobro raziskano</string>
    <string name="map_layer_first_contact_title">Prvi stik</string>
    <string name="map_layer_first_contact_chip">Odkritje</string>
    <string name="map_layer_first_contact_description">Časovnica odkritij: vsako območje je obarvano glede na to, kako nedavno ste tja prvič stopili. Kraji, ki ste jih našli davno, zbledijo v globoko indigo, tla, ki ste jih odkrili ta teden, pa žarijo v svetlem cianu — zgodbo raziskovanja berite navzven proti najnovejšim mejam.</string>
