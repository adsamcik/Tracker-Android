    <string name="map_layer_speed_fast">Hitro gibanje</string>
    <string name="map_layer_speed_very_fast">Zelo hitro</string>
    <string name="map_layer_speed_heatmap_title">Toplotni zemljevid hitrosti</string>
    <string name="map_layer_legacy_heatmap_title">Stari toplotni zemljevid</string>
    <string name="map_layer_legacy_heatmap_chip">Stare ploščice</string>
    <string name="map_layer_legacy_heatmap_description">Povratek k izvirni aplikaciji Signals: gostota lokacije je narisana kot ločene mrežne ploščice velikosti 25 m, tako kot je bil toplotni zemljevid videti, ko je strežnik upodabljal ploščice. Povečajte za ogled kvadratov.</string>
    <string name="map_layer_seasonal_title">Sezonski raziskovalec</string>
    <string name="map_layer_seasonal_chip">Letni časi</string>
    <string name="map_layer_seasonal_description">Mozaik sezonskega spomina: vsako območje, ki ste ga raziskali, je obarvano glede na letni čas prvega obiska. Poiščite poti, po katerih hodite le poleti, ali ulice, ki jih vidite le pozimi.</string>
    <string name="map_layer_season_spring">Pomlad</string>
    <string name="map_layer_season_summer">Poletje</string>
    <string name="map_layer_season_autumn">Jesen</string>
    <string name="map_layer_season_winter">Zima</string>
    <string name="map_layer_terrain_title">Življenje kot teren</string>
    <string name="map_layer_terrain_chip">Teren</string>
    <string name="map_layer_terrain_description">Gostota lokacije, dvignjena v 3D: kraji, kjer preživite največ časa, se dvignejo kot visoke žareče planote, enkratno obiskani kraji pa ostanejo nizki. Nagnite zemljevid za relief svojega življenja.</string>
    <string name="map_layer_terrain_low">Redko tukaj</string>
    <string name="map_layer_terrain_mid">Včasih</string>
    <string name="map_layer_terrain_high">Pogosto tukaj</string>
    <string name="map_layer_speed_ribbon_title">Trak hitrosti</string>
    <string name="map_layer_speed_ribbon_chip">Trak</string>
    <string name="map_layer_speed_ribbon_description">Pot je pobarvana glede na hitrost gibanja, s tekočo barvo od počasnega vijoličastega sprehoda do rdeče vročega šprinta ali vožnje. Za razliko od toplotnega zemljevida hitrosti trak ohrani pot, zato natančno vidite, kje ste pospešili in upočasnili.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Trak nadmorske višine</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Nadmorska višina</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Pot je pobarvana glede na absolutno nadmorsko višino, od globoko modrih nižin prek cianastih vznožij do toplih gorskih višin. Merilo ostane fiksno med premikanjem zemljevida, zato ima ista višina vedno isto barvo.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Nižine</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Vznožja</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Visoke gore</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Trak dejavnosti</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Dejavnost</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Pot je pobarvana glede na zanesljivo stanje gibanja, zabeleženo ob vsaki določitvi lokacije: sivo, kadar stanje ni znano, modro med mirovanjem in zeleno med gibanjem.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Neznano</string>
    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Mirovanje</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">Gibanje</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">Smučarski rentgen</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Smučarski rentgen</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Diagnostični prikaz zaznanih smučarskih odsekov. Spusti navzdol, žičnice, hoje in premori so pripeti na najbližjo zabeleženo lokacijo ter označeni s ključnimi meritvami.</string>
