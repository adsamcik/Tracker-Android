    <string name="map_layer_signal_coverage_chip">Mrtve cone</string>
    <string name="map_layer_signal_coverage_description">Poudari kraje, kjer je bil signal mobilne celice šibek ali ga ni bilo. Bolj ko je območje rdeče, slabša je pokritost; dobro pokrita območja ostanejo jasna.</string>
