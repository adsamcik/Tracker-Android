    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Polarni sij signala</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Aurora</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Signal celice je upodobljen kot sij, podoben polarnemu siju: širok vijoličen obroč pod svetlim cianozelenim jedrom. Sij utripa brez ponovnega nalaganja podatkov in postane statičen, ko so sistemske animacije onemogočene.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Šibek signal</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Močan signal</string>
    <string name="map_layer_speed_heatmap_description">Toplotni zemljevid, ki prikazuje hitrost gibanja po različnih območjih.</string>
    <string name="map_layer_speed_very_slow">Zelo počasi</string>
    <string name="map_layer_speed_walking">Tempo hoje</string>
    <string name="map_layer_speed_running">Tempo teka</string>
