    <string name="map_layer_signal_coverage_title">Signāla mirušās zonas</string>
    <string name="map_layer_signal_coverage_chip">Mirušās zonas</string>
    <string name="map_layer_signal_coverage_description">Izceļ vietas, kur mobilo sakaru signāls bija vājš vai nebija pieejams. Jo sarkanāks apgabals, jo sliktāks pārklājums; labi pārklātie apgabali paliek skaidri.</string>
    <string name="map_layer_signal_coverage_weak">Vājš</string>
    <string name="map_layer_signal_coverage_poor">Slikts</string>
    <string name="map_layer_signal_coverage_very_poor">Ļoti slikts</string>
    <string name="map_layer_signal_coverage_dead">Mirušā zona</string>
    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Signāla polārblāzma</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Polārblāzma</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Šūnu signāls attēlots kā polārblāzmai līdzīgs mirdzums: plaša violeta oreola josla zem spilgta ciānzaļa kodola. Mirdzums pulsē, nepārlādējot datus, un kļūst nekustīgs, kad sistēmas animācijas ir atspējotas.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Vājš signāls</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Spēcīgs signāls</string>
    <string name="map_layer_speed_heatmap_description">Siltumkarte, kas attēlo pārvietošanās ātrumu dažādos apgabalos.</string>
    <string name="map_layer_speed_very_slow">Ļoti lēni</string>
    <string name="map_layer_speed_walking">Iešanas temps</string>
    <string name="map_layer_speed_running">Skriešanas temps</string>
    <string name="map_layer_speed_moderate">Mērens ātrums</string>
    <string name="map_layer_speed_fast">Ātra pārvietošanās</string>
    <string name="map_layer_speed_very_fast">Ļoti ātri</string>
    <string name="map_layer_speed_heatmap_title">Ātruma siltumkarte</string>
    <string name="map_layer_legacy_heatmap_title">Mantotā siltumkarte</string>
    <string name="map_layer_legacy_heatmap_chip">Mantotās mozaīkas</string>
    <string name="map_layer_legacy_heatmap_description">Atsauce uz sākotnējo lietotni Signals: jūsu atrašanās vietu blīvums attēlots kā atsevišķas 25\u202fm režģa mozaīkas, kā siltumkarte izskatījās, kad mozaīkas tika renderētas serverī. Pietuviniet, lai redzētu kvadrātus.</string>
    <string name="map_layer_seasonal_title">Gadalaiku pētnieks</string>
    <string name="map_layer_seasonal_chip">Gadalaiki</string>
    <string name="map_layer_seasonal_description">Gadalaiku atmiņu sega: katrs jūsu izpētītais apgabals ir iekrāsots tā gadalaika tonī, kurā to pirmoreiz apmeklējāt. Atrodiet takas, pa kurām ejat tikai vasarā, vai ielas, ko redzat tikai ziemā.</string>
    <string name="map_layer_season_spring">Pavasaris</string>
    <string name="map_layer_season_summer">Vasara</string>
    <string name="map_layer_season_autumn">Rudens</string>
    <string name="map_layer_season_winter">Ziema</string>
    <string name="map_layer_terrain_title">Dzīve kā reljefs</string>
    <string name="map_layer_terrain_chip">Reljefs</string>
    <string name="map_layer_terrain_description">Jūsu atrašanās vietu blīvums pacelts 3D formā: vietas, kur pavadāt visvairāk laika, paceļas kā augsti mirdzoši plakankalni, bet vienreizēji punkti paliek zemi. Nolieciet karti, lai redzētu savas dzīves reljefu.</string>
    <string name="map_layer_terrain_low">Reti šeit</string>
    <string name="map_layer_terrain_mid">Dažreiz</string>
    <string name="map_layer_terrain_high">Bieži šeit</string>
    <string name="map_layer_speed_ribbon_title">Ātruma lente</string>
    <string name="map_layer_speed_ribbon_chip">Lente</string>
    <string name="map_layer_speed_ribbon_description">Jūsu maršruts ir iekrāsots pēc pārvietošanās ātruma — plūstošā krāsā no lēnas violetas pastaigas līdz sarkani karstam sprintam vai braucienam. Atšķirībā no ātruma siltumkartes lente saglabā maršruta līniju, lai redzētu, kur tieši paātrinājāties un palēninājāties.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Augstuma lente</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Augstums</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Jūsu maršruts ir iekrāsots pēc absolūtā augstuma — no dziļi zilām zemienēm caur ciāna pakājēm līdz siltiem kalnu augstumiem. Skala paliek fiksēta, pārvietojot karti, tāpēc viens un tas pats augstums vienmēr saglabā vienu krāsu.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Zemienes</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Pakājes</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Augstie kalni</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Aktivitāšu lente</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktivitāte</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Jūsu maršruts ir iekrāsots pēc uzticamā kustības stāvokļa, kas ierakstīts ar katru labojumu: pelēks, kad stāvoklis nav zināms, zils nekustoties un zaļš kustoties.</string>
