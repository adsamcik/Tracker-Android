    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">Kustībā</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">Slēpošanas rentgens</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Slēpošanas rentgens</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Noteikto slēpošanas segmentu diagnostikas skats. Nobraucieni lejup, pacēlāji, pastaigas un pauzes ir piesaistītas tuvākajai ierakstītajai atrašanās vietai un marķētas ar galvenajiem rādītājiem.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Nobrauciens lejup</string>
    <string name="map_layer_ski_lift" tools:ignore="MissingTranslation">Pacēlājs</string>
    <string name="map_layer_ski_walk" tools:ignore="MissingTranslation">Pastaiga vai pauze</string>
    <string name="map_layer_fog_title">Pētnieka migla</string>
    <string name="map_layer_fog_chip">Migla</string>
    <string name="map_layer_fog_description">Pasaule, kas iznirst no miglas: atklājas katrs apgabals, kuru esat skāris, un tas mirdz jo spilgtāk, jo rūpīgāk to iepazināt. Vietas, kurām tikai izgājāt cauri, paliek vieglā dūmakā; dziļi izpētītās vietas deg tīrā zeltā. Neizpētīta zeme paliek tumša.</string>
    <string name="map_layer_fog_faint">Iziets cauri</string>
    <string name="map_layer_fog_known">Labi izpētīts</string>
    <string name="map_layer_first_contact_title">Pirmais kontakts</string>
    <string name="map_layer_first_contact_chip">Atklājums</string>
    <string name="map_layer_first_contact_description">Jūsu atklājumu laika skala: katrs apgabals ir iekrāsots pēc tā, cik sen tajā pirmoreiz spērāt kāju. Sen atrastās vietas izbalē līdz dziļam indigo, bet šonedēļ atklātā zeme mirdz spilgti ciānā — lasiet savas izpētes stāstu no jaunākajām robežām uz āru.</string>
