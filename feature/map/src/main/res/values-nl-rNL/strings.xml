    <string name="map_layer_speed_heatmap_description">Warmtekaart die de bewegingssnelheid in verschillende gebieden weergeeft.</string>
    <string name="map_layer_speed_very_slow">Zeer langzaam</string>
    <string name="map_layer_speed_walking">Wandeltempo</string>
    <string name="map_layer_speed_running">Hardlooptempo</string>
