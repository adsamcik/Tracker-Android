    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Ski-röntgenfoto</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Een diagnostische weergave van gedetecteerde skisegmenten. Afdalingen, liften, wandelingen en pauzes zijn verankerd aan de dichtstbijzijnde vastgelegde locatie en voorzien van hun belangrijkste statistieken.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Afdaling</string>
    <string name="map_layer_ski_lift" tools:ignore="MissingTranslation">Skilift</string>
    <string name="map_layer_ski_walk" tools:ignore="MissingTranslation">Wandelen of pauzeren</string>
