    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Ritten</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Herhaalde reizen tussen je vaak bezochte plaatsen worden gebogen sterrenbeelden. Een stabiele boog toont elke route terwijl een komeet erlangs beweegt; dikkere bogen betekenen dat je die reis vaker hebt gemaakt.</string>
