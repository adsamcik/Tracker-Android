    <string name="map_layer_speed_very_fast">Zeer snel</string>
    <string name="map_layer_speed_heatmap_title">Snelheidswarmtekaart</string>
    <string name="map_layer_legacy_heatmap_title">Klassieke warmtekaart</string>
    <string name="map_layer_legacy_heatmap_chip">Klassieke tegels</string>
    <string name="map_layer_legacy_heatmap_description">Terugblik op de oorspronkelijke Signals-app: je locatiedichtheid getekend als afzonderlijke rastertegels van 25 m, zoals de warmtekaart eruitzag toen tegels op de server werden gerenderd. Zoom in om de vierkanten te zien.</string>
    <string name="map_layer_seasonal_title">Seizoensverkenner</string>
    <string name="map_layer_seasonal_chip">Seizoenen</string>
    <string name="map_layer_seasonal_description">Een lappendeken van seizoensherinneringen: elk gebied dat je hebt verkend krijgt de tint van het seizoen waarin je het voor het eerst bezocht. Vind de paden die je alleen in de zomer bewandelt, of de straten die je alleen in de winter ziet.</string>
    <string name="map_layer_season_spring">Lente</string>
    <string name="map_layer_season_summer">Zomer</string>
    <string name="map_layer_season_autumn">Herfst</string>
    <string name="map_layer_season_winter">Winter</string>
    <string name="map_layer_terrain_title">Leven als terrein</string>
    <string name="map_layer_terrain_chip">Terrein</string>
    <string name="map_layer_terrain_description">Je locatiedichtheid opgetild in 3D: plekken waar je de meeste tijd doorbrengt rijzen op als hoge gloeiende mesa’s, terwijl eenmalige plekken laag blijven. Kantel de kaart om het reliëf van je leven te zien.</string>
    <string name="map_layer_terrain_low">Zelden hier</string>
    <string name="map_layer_terrain_mid">Soms</string>
    <string name="map_layer_terrain_high">Vaak hier</string>
    <string name="map_layer_places_title">Veelbezochte plaatsen</string>
    <string name="map_layer_places_chip">Plaatsen</string>
    <string name="map_layer_places_description">Je belangrijke plaatsen als markeringen, elk zo groot en gekleurd op basis van hoe vaak je er komt. Thuis en werk worden grote warme stippen; een plek die je één keer bezocht blijft klein en koel.</string>
    <string name="map_layer_places_rare">Zelden</string>
    <string name="map_layer_places_often">Soms</string>
    <string name="map_layer_places_anchor">Je ankerpunten</string>
    <string name="map_layer_speed_ribbon_title">Snelheidslint</string>
    <string name="map_layer_speed_ribbon_chip">Lint</string>
    <string name="map_layer_speed_ribbon_description">Je route gekleurd naar hoe snel je bewoog, met vloeiende kleuren van een trage violette wandeling naar een roodgloeiende sprint of autorit. Anders dan de snelheidswarmtekaart houdt het lint je pad intact, zodat je precies ziet waar je versnelde en vertraagde.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Hoogtelint</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Hoogte</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Je route gekleurd naar absolute hoogte, van diepblauwe laaglanden via cyaan uitlopers tot warme bergtoppen. De schaal blijft vast terwijl je de kaart verplaatst, zodat dezelfde hoogte altijd dezelfde kleur houdt.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Laaglanden</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Uitlopers</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Hoge bergen</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Activiteitenlint</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Activiteit</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Je route gekleurd naar de betrouwbare bewegingsstatus die bij elke locatiebepaling is vastgelegd: grijs waar de status onbekend was, blauw wanneer je stilstond en groen wanneer je bewoog.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Onbekend</string>
    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Stilstaand</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">In beweging</string>
