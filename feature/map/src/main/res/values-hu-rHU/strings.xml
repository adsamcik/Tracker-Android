    <string name="map_layer_terrain_mid">Néha</string>
    <string name="map_layer_terrain_high">Gyakran itt</string>
    <string name="map_layer_speed_ribbon_title">Sebességszalag</string>
    <string name="map_layer_speed_ribbon_chip">Szalag</string>
    <string name="map_layer_speed_ribbon_description">Az útvonala a mozgási sebesség szerint festve, a lassú ibolyaszínű sétától a vörösen izzó sprintig vagy vezetésig áramló színekkel. A sebesség-hőtérképtől eltérően a szalag érintetlenül tartja az útvonalat, így pontosan láthatja, hol gyorsított és lassított.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Magassági szalag</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Magasság</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Az útvonala abszolút tengerszint feletti magasság szerint festve, a mélykék alföldektől a ciánszínű előhegyeken át a meleg hegyvidéki magasságokig. A skála pásztázáskor rögzített marad, így ugyanaz a magasság mindig ugyanazt a színt tartja.</string>
