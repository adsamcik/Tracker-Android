    <string name="map_layer_terrain_title">Élet mint domborzat</string>
    <string name="map_layer_terrain_chip">Domborzat</string>
    <string name="map_layer_terrain_description">A helyadat-sűrűségét 3D-ben emeli ki: a legtöbb időt töltött helyek magas, ragyogó fennsíkként emelkednek ki, míg az egyszer meglátogatott pontok alacsonyak maradnak. Döntse meg a térképet, hogy lássa élete domborzatát.</string>
