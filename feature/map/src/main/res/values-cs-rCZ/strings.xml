    <string name="map_layer_speed_fast">Rychlý pohyb</string>
    <string name="map_layer_speed_very_fast">Velmi rychlý pohyb</string>
    <string name="map_layer_speed_heatmap_title">Teplotní mapa rychlosti</string>
    <string name="map_layer_legacy_heatmap_title">Historická teplotní mapa</string>
    <string name="map_layer_legacy_heatmap_chip">Historické dlaždice</string>
    <string name="map_layer_legacy_heatmap_description">Návrat k původní aplikaci Signals: hustota polohy jako samostatné dlaždice mřížky o velikosti 25\u202fm, tak jak vypadala teplotní mapa při vykreslování dlaždic na serveru. Přiblížením zobrazíte čtverce.</string>
    <string name="map_layer_seasonal_title">Sezónní objevitel</string>
    <string name="map_layer_seasonal_chip">Roční období</string>
    <string name="map_layer_seasonal_description">Mozaika sezónních vzpomínek: každá prozkoumaná oblast je zbarvena podle ročního období, kdy jste ji poprvé navštívili. Najděte stezky, po kterých chodíte jen v létě, nebo ulice, které vídáte jen v zimě.</string>
    <string name="map_layer_season_spring">Jaro</string>
    <string name="map_layer_season_summer">Léto</string>
    <string name="map_layer_season_autumn">Podzim</string>
    <string name="map_layer_season_winter">Zima</string>
    <string name="map_layer_terrain_title">Život jako terén</string>
    <string name="map_layer_terrain_chip">Terén</string>
    <string name="map_layer_terrain_description">Hustota polohy převedená do 3D: místa, kde trávíte nejvíce času, vystupují jako vysoké zářící stolové hory, zatímco jednorázově navštívená místa zůstávají nízko. Nakloňte mapu a uvidíte reliéf svého života.</string>
    <string name="map_layer_terrain_low">Zřídka zde</string>
    <string name="map_layer_terrain_mid">Někdy</string>
    <string name="map_layer_terrain_high">Často zde</string>
    <string name="map_layer_speed_ribbon_title">Pás rychlosti</string>
    <string name="map_layer_speed_ribbon_chip">Pás</string>
    <string name="map_layer_speed_ribbon_description">Trasa zbarvená podle rychlosti pohybu, plynulou barvou od pomalého fialového kroku k žhavě červenému sprintu nebo jízdě. Na rozdíl od teplotní mapy rychlosti pás zachovává celou cestu, takže přesně vidíte, kde jste zrychlili a zpomalili.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Pás nadmořské výšky</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Nadmořská výška</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Trasa zbarvená podle absolutní nadmořské výšky, od tmavě modrých nížin přes azurové podhůří po teplé horské výšky. Měřítko při posouvání mapy zůstává pevné, takže stejná výška má vždy stejnou barvu.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Nížiny</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Podhůří</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Vysoké hory</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Pás aktivity</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktivita</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Trasa zbarvená podle spolehlivého stavu pohybu zaznamenaného s každým určením polohy: šedě při neznámém stavu, modře v klidu a zeleně při pohybu.</string>
