    <string name="map_layer_signal_coverage_title">Mrtvé zóny signálu</string>
    <string name="map_layer_signal_coverage_chip">Mrtvé zóny</string>
    <string name="map_layer_signal_coverage_description">Zvýrazňuje místa, kde byl signál mobilní sítě slabý nebo chyběl. Čím červenější oblast, tím horší pokrytí; dobře pokryté oblasti zůstávají čisté.</string>
    <string name="map_layer_signal_coverage_weak">Slabé</string>
