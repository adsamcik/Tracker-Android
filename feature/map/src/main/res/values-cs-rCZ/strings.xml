    <string name="map_layer_signal_coverage_very_poor">Velmi špatné</string>
    <string name="map_layer_signal_coverage_dead">Mrtvá zóna</string>
    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Polární záře signálu</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Záře</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Signál mobilní sítě vykreslený jako záře podobná polární záři: široký fialový halo pod jasným azurově zeleným jádrem. Záře pulzuje bez opětovného načítání dat a při vypnutých systémových animacích zůstane statická.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Slabý signál</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Silný signál</string>
    <string name="map_layer_speed_heatmap_description">Teplotní mapa znázorňující rychlost pohybu v různých oblastech.</string>
    <string name="map_layer_speed_very_slow">Velmi pomalý pohyb</string>
    <string name="map_layer_speed_walking">Tempo chůze</string>
    <string name="map_layer_speed_running">Tempo běhu</string>
