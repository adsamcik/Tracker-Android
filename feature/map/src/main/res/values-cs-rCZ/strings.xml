    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Lyžařský rentgen</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Diagnostický pohled na zjištěné lyžařské úseky. Sjezdy, vleky, chůze a pauzy jsou ukotveny k nejbližší zaznamenané poloze a označeny hlavními metrikami.</string>
