    <string name="map_layer_fog_chip">Mlha</string>
    <string name="map_layer_fog_description">Svět vystupuje z mlhy: každá oblast, které jste se dotkli, se odhalí a září tím jasněji, čím důkladněji jste ji poznali. Místa, jimiž jste jen prošli, zůstávají slabým oparem; hluboce prozkoumané místo září sytě zlatě. Neprozkoumaná zem zůstává tmavá.</string>
    <string name="map_layer_fog_faint">Pouze průchod</string>
    <string name="map_layer_fog_known">Dobře prozkoumáno</string>
    <string name="map_layer_first_contact_title">První kontakt</string>
    <string name="map_layer_first_contact_chip">Objev</string>
    <string name="map_layer_first_contact_description">Časová osa vašich objevů: každá oblast je zbarvena podle toho, jak nedávno jste do ní poprvé vstoupili. Místa objevená dávno vyblednou do tmavé indigové barvy, zatímco území prozkoumané tento týden září jasnou azurovou — čtěte příběh svého objevování až k nejnovějším hranicím.</string>
