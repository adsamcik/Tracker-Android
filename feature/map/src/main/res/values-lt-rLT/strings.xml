    <string name="map_layer_fog_known">Gerai ištirta</string>
    <string name="map_layer_first_contact_title">Pirmasis kontaktas</string>
    <string name="map_layer_first_contact_chip">Atradimas</string>
    <string name="map_layer_first_contact_description">Jūsų atradimų laiko juosta: kiekviena sritis nuspalvinta pagal tai, kaip neseniai pirmą kartą joje apsilankėte. Seniai atrastos vietos blunka iki sodrios indigo spalvos, o šią savaitę atrasta žemė švyti ryškia žydra – perskaitykite savo tyrinėjimo istoriją iki naujausių pakraščių.</string>
    <string name="map_layer_first_contact_old">Seniai</string>
    <string name="map_layer_first_contact_recent">Ką tik atrasta</string>
    <string name="map_layer_vehicle_compliance_title">Transporto priemonės greičio atitiktis</string>
