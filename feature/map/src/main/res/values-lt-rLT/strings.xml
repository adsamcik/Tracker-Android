    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Kelionės</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Pasikartojančios kelionės tarp dažnų vietų tampa lenktais žvaigždynais. Stabili arka rodo kiekvieną maršrutą, o juo keliauja kometa; storesnės arkos reiškia, kad šią kelionę atlikote dažniau.</string>
    <string name="map_layer_trip_walk" tools:ignore="MissingTranslation">Ėjimas</string>
