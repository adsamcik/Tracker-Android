    <string name="map_layer_fog_title">Tyrinėtojo rūkas</string>
    <string name="map_layer_fog_chip">Rūkas</string>
    <string name="map_layer_fog_description">Pasaulis išnyra iš rūko: kiekviena jūsų aplankyta sritis atskleidžiama ir švyti ryškiau, kuo geriau ją pažįstate. Vietos, pro kurias tik praėjote, lieka blankioje migloje; giliai ištirta vieta dega sodriu auksu. Neištirta žemė lieka tamsi.</string>
