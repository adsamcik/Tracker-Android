    <string name="map_layer_signal_coverage_title">Signalo aklosios zonos</string>
    <string name="map_layer_signal_coverage_chip" translatable="false">Dead zones</string>
    <string name="map_layer_signal_coverage_description">Pažymi vietas, kur mobiliojo ryšio signalas buvo silpnas arba jo nebuvo. Kuo sritis raudonesnė, tuo blogesnė aprėptis; gerai padengtos sritys lieka skaidrios.</string>
    <string name="map_layer_signal_coverage_weak" translatable="false">Weak</string>
    <string name="map_layer_signal_coverage_poor" translatable="false">Poor</string>
    <string name="map_layer_signal_coverage_very_poor" translatable="false">Very poor</string>
    <string name="map_layer_signal_coverage_dead" translatable="false">Dead zone</string>
    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Signalo pašvaistė</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Pašvaistė</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Mobiliojo ryšio signalas pateikiamas kaip pašvaistės spindesys: plati violetinė aureolė po ryškiu žydrai žaliu branduoliu. Spindesys pulsuoja neperkeliant duomenų ir tampa nejudrus, kai sistemos animacijos išjungtos.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Silpnas signalas</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Stiprus signalas</string>
    <string name="map_layer_speed_heatmap_description">Šilumos žemėlapis, rodantis judėjimo greitį skirtingose vietose.</string>
    <string name="map_layer_speed_very_slow">Labai lėtai</string>
    <string name="map_layer_speed_walking">Ėjimo tempas</string>
    <string name="map_layer_speed_running">Bėgimo tempas</string>
    <string name="map_layer_speed_moderate">Vidutinis greitis</string>
    <string name="map_layer_speed_fast">Greitas judėjimas</string>
    <string name="map_layer_speed_very_fast">Labai greitai</string>
    <string name="map_layer_speed_heatmap_title">Greičio šilumos žemėlapis</string>
    <string name="map_layer_legacy_heatmap_title">Senasis šilumos žemėlapis</string>
    <string name="map_layer_legacy_heatmap_chip">Senosios plytelės</string>
    <string name="map_layer_legacy_heatmap_description">Grįžimas prie pirminės „Signals“ programos: jūsų vietos tankis rodomas atskiromis 25 m tinklelio plytelėmis, kaip šilumos žemėlapis atrodė, kai plytelės buvo piešiamos serveryje. Priartinkite, kad pamatytumėte kvadratus.</string>
    <string name="map_layer_seasonal_title">Metų laikų tyrinėtojas</string>
    <string name="map_layer_seasonal_chip">Metų laikai</string>
    <string name="map_layer_seasonal_description">Metų laikų atminties mozaika: kiekviena jūsų ištirta sritis nuspalvinta metų laiku, kuriuo joje lankėtės pirmą kartą. Raskite takus, kuriais vaikštote tik vasarą, ar gatves, kurias matote tik žiemą.</string>
    <string name="map_layer_season_spring">Pavasaris</string>
    <string name="map_layer_season_summer">Vasara</string>
    <string name="map_layer_season_autumn">Ruduo</string>
    <string name="map_layer_season_winter">Žiema</string>
    <string name="map_layer_terrain_title">Gyvenimas kaip reljefas</string>
    <string name="map_layer_terrain_chip">Reljefas</string>
    <string name="map_layer_terrain_description">Jūsų vietos tankis pakeltas į 3D: vietos, kur praleidžiate daugiausia laiko, iškyla kaip aukštos švytinčios plynaukštės, o vienkartiniai taškai lieka žemi. Pakreipkite žemėlapį ir pamatykite savo gyvenimo reljefą.</string>
    <string name="map_layer_terrain_low">Retai čia</string>
    <string name="map_layer_terrain_mid">Kartais</string>
    <string name="map_layer_terrain_high">Dažnai čia</string>
    <string name="map_layer_places_title">Dažnos vietos</string>
    <string name="map_layer_places_chip">Vietos</string>
    <string name="map_layer_places_description">Svarbios vietos žymimos ženklais, kurių dydis ir spalva priklauso nuo apsilankymo dažnio. Namai ir darbas tampa dideliais šiltais taškais, o vieną kartą aplankyta vieta lieka maža ir vėsi.</string>
    <string name="map_layer_places_rare">Retai</string>
    <string name="map_layer_places_often">Kartais</string>
    <string name="map_layer_places_anchor">Jūsų atramos</string>
    <string name="map_layer_speed_ribbon_title">Greičio juosta</string>
    <string name="map_layer_speed_ribbon_chip">Juosta</string>
    <string name="map_layer_speed_ribbon_description">Maršrutas nuspalvintas pagal judėjimo greitį: spalva teka nuo lėto violetinio pasivaikščiojimo iki raudonai karšto sprinto ar važiavimo. Kitaip nei greičio šilumos žemėlapis, juosta išlaiko maršrutą nepažeistą, todėl tiksliai matote, kur pagreitėjote ir sulėtėjote.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Aukščio juosta</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Aukštis</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Maršrutas nuspalvintas pagal absoliutų aukštį: nuo gilių mėlynų žemumų per žydras priekalnes iki šiltų kalnų aukštumų. Mastelis lieka fiksuotas slenkant žemėlapį, todėl tas pats aukštis visada turi tą pačią spalvą.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Žemumos</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Priekalnės</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Aukšti kalnai</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Veiklos juosta</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Veikla</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Maršrutas nuspalvintas pagal patikimą judėjimo būseną, užfiksuotą su kiekvienu vietos nustatymu: pilka, kai būsena nežinoma, mėlyna nejudant ir žalia judant.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Nežinoma</string>
