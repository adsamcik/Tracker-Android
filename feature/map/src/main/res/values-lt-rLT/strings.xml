    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">Juda</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">Slidinėjimo rentgenas</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Slidinėjimo rentgenas</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Diagnostinis aptiktų slidinėjimo segmentų rodinys. Nusileidimai, keltuvai, ėjimas ir pauzės susiejami su artimiausia įrašyta vieta ir pažymimi pagrindiniais rodikliais.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Nusileidimas</string>
