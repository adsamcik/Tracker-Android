    <string name="map_layer_fog_title">Udforskerens tåge</string>
    <string name="map_layer_fog_chip">Tåge</string>
    <string name="map_layer_fog_description">Verden, der træder frem af tågen: hvert område, du har berørt, afsløres og lyser klarere, jo grundigere du har lært det at kende. Steder, du kun passerede, forbliver en svag dis; et sted, du udforskede dybt, brænder gyldent. Uudforsket terræn forbliver mørkt.</string>
    <string name="map_layer_fog_faint">Passeret</string>
    <string name="map_layer_fog_known">Godt udforsket</string>
    <string name="map_layer_first_contact_title">Første kontakt</string>
    <string name="map_layer_first_contact_chip">Opdagelse</string>
    <string name="map_layer_first_contact_description">En tidslinje over dine opdagelser: hvert område er farvet efter, hvor længe siden du først satte fod der. Steder, du fandt for længe siden, falmer til dyb indigo, mens terræn, du åbnede op for i denne uge, lyser klart cyan — læs historien om din udforskning ud til dine nyeste grænser.</string>
