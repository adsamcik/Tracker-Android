    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">Ski-røntgen</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">En diagnostisk visning af registrerede skisegmenter. Nedfarter, lifter, gåture og pauser forankres ved den nærmeste registrerede placering og mærkes med deres vigtigste målinger.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Nedfart</string>
