    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Signalnordlys</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Nordlys</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Mobilsignal gengivet som et nordlyslignende skær: en bred violet glorie under en lys cyan-grøn kerne. Skæret pulserer uden at genindlæse data og bliver statisk, når systemanimationer er deaktiveret.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Svagt signal</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Stærkt signal</string>
    <string name="map_layer_speed_heatmap_description">Varmekort, der viser bevægelseshastigheden på tværs af forskellige områder.</string>
    <string name="map_layer_speed_very_slow">Meget langsom</string>
    <string name="map_layer_speed_walking">Gangtempo</string>
    <string name="map_layer_speed_running">Løbetempo</string>
    <string name="map_layer_speed_moderate">Moderat hastighed</string>
    <string name="map_layer_speed_fast">Hurtig bevægelse</string>
    <string name="map_layer_speed_very_fast">Meget hurtig</string>
    <string name="map_layer_speed_heatmap_title">Hastighedsvarmekort</string>
    <string name="map_layer_legacy_heatmap_title">Klassisk varmekort</string>
    <string name="map_layer_legacy_heatmap_chip">Klassiske fliser</string>
    <string name="map_layer_legacy_heatmap_description">En hyldest til den oprindelige Signals-app: din placeringstæthed tegnet som separate 25 m-gitterfliser, sådan som varmekortet så ud, da fliser blev gengivet på serveren. Zoom ind for at se kvadraterne.</string>
    <string name="map_layer_seasonal_title">Sæsonudforsker</string>
    <string name="map_layer_seasonal_chip">Sæsoner</string>
    <string name="map_layer_seasonal_description">Et tæppe af sæsonminder: hvert område, du har udforsket, tones efter den sæson, du først besøgte det i. Find stier, du kun går om sommeren, eller gader du kun ser om vinteren.</string>
    <string name="map_layer_season_spring">Forår</string>
    <string name="map_layer_season_summer">Sommer</string>
    <string name="map_layer_season_autumn">Efterår</string>
    <string name="map_layer_season_winter">Vinter</string>
    <string name="map_layer_terrain_title">Livet som terræn</string>
    <string name="map_layer_terrain_chip">Terræn</string>
    <string name="map_layer_terrain_description">Din placeringstæthed løftet til 3D: stederne, hvor du bruger mest tid, rejser sig som høje lysende plateauer, mens enkeltstående steder forbliver lave. Vip kortet for at se dit livs relief.</string>
    <string name="map_layer_terrain_low">Sjældent her</string>
    <string name="map_layer_terrain_mid">Af og til</string>
    <string name="map_layer_terrain_high">Ofte her</string>
    <string name="map_layer_places_title">Hyppige steder</string>
    <string name="map_layer_places_chip">Steder</string>
    <string name="map_layer_places_description">Dine vigtige steder som markører, hver med størrelse og farve efter hvor ofte du besøger dem. Hjem og arbejde bliver store, varme prikker; et sted, du kun har været ét enkelt gang, forbliver en lille, kølig prik.</string>
    <string name="map_layer_places_rare">Sjældent</string>
    <string name="map_layer_places_often">Af og til</string>
    <string name="map_layer_places_anchor">Dine holdepunkter</string>
    <string name="map_layer_speed_ribbon_title">Hastighedsbånd</string>
    <string name="map_layer_speed_ribbon_chip">Bånd</string>
    <string name="map_layer_speed_ribbon_description">Din rute farvelægges efter, hvor hurtigt du bevægede dig, med flydende farver fra en langsom violet spadseretur til en rødglødende sprint eller køretur. I modsætning til hastighedsvarmekortet bevarer båndet din sti, så du kan se præcis, hvor du satte farten op og sænkede den.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Højdebånd</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Højde</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Din rute farvelægges efter absolut højde, fra dybblåt lavland over cyanfarvede forbjerge til varme bjerghøjder. Skalaen forbliver fast, mens du flytter kortet, så den samme højde altid har den samme farve.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Lavland</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Forbjerge</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Høje bjerge</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Aktivitetsbånd</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Aktivitet</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Din rute farvelægges efter den pålidelige bevægelsestilstand, der er registreret ved hver måling: grå, når tilstanden var ukendt, blå når du stod stille, og grøn når du bevægede dig.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Ukendt</string>
    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Står stille</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">I bevægelse</string>
