    <string name="map_layer_signal_coverage_title">Criosanna marbha comhartha</string>
    <string name="map_layer_signal_coverage_chip" translatable="false">Dead zones</string>
    <string name="map_layer_signal_coverage_description">Aibhsíonn sé áiteanna ina raibh do chomhartha cille lag nó ar iarraidh. Dá dheirge an limistéar, is measa an clúdach; fanann limistéir dea-chlúdaithe soiléir.</string>
    <string name="map_layer_signal_coverage_weak" translatable="false">Weak</string>
    <string name="map_layer_signal_coverage_poor" translatable="false">Poor</string>
    <string name="map_layer_signal_coverage_very_poor" translatable="false">Very poor</string>
    <string name="map_layer_signal_coverage_dead" translatable="false">Dead zone</string>
    <string name="map_layer_signal_aurora_title" tools:ignore="MissingTranslation">Auróra comhartha</string>
    <string name="map_layer_signal_aurora_chip" tools:ignore="MissingTranslation">Auróra</string>
    <string name="map_layer_signal_aurora_description" tools:ignore="MissingTranslation">Comhartha cille rindreáilte mar lonrú cosúil le hóróra: fáinne leathan corcra faoi chroílár geal cian-uaine. Bogann an lonrú gan sonraí a athlódáil agus éiríonn sé statach nuair a dhíchumasaítear beochana córais.</string>
    <string name="map_layer_signal_aurora_faint" tools:ignore="MissingTranslation">Comhartha fann</string>
    <string name="map_layer_signal_aurora_strong" tools:ignore="MissingTranslation">Comhartha láidir</string>
    <string name="map_layer_speed_heatmap_description">Léarscáil teasa a léiríonn luas na gluaiseachta thar limistéir éagsúla.</string>
    <string name="map_layer_speed_very_slow">An-mhall</string>
    <string name="map_layer_speed_walking">Luas siúil</string>
    <string name="map_layer_speed_running">Luas reatha</string>
    <string name="map_layer_speed_moderate">Luas measartha</string>
    <string name="map_layer_speed_fast">Gluaiseacht thapa</string>
    <string name="map_layer_speed_very_fast">An-tapa</string>
    <string name="map_layer_speed_heatmap_title">Léarscáil teasa luais</string>
    <string name="map_layer_legacy_heatmap_title">Léarscáil teasa oidhreachta</string>
    <string name="map_layer_legacy_heatmap_chip">Tíleanna oidhreachta</string>
    <string name="map_layer_legacy_heatmap_description">Tagairt don aip Signals bhunaidh: dlús do shuímh tarraingthe mar thíleanna greille ar leith 25 m, mar a bhí an léarscáil teasa nuair a rindreáladh tíleanna ar an bhfreastalaí. Zúmáil isteach chun na cearnóga a fheiceáil.</string>
    <string name="map_layer_seasonal_title">Taiscéalaí séasúrach</string>
    <string name="map_layer_seasonal_chip">Séasúir</string>
    <string name="map_layer_seasonal_description">Meascán cuimhní séasúracha: tá dath séasúir do chéad chuairte ar gach limistéar a ndearna tú taiscéaladh air. Faigh na cosáin nach siúlann tú ach sa samhradh, nó na sráideanna nach bhfeiceann tú ach sa gheimhreadh.</string>
    <string name="map_layer_season_spring">Earrach</string>
    <string name="map_layer_season_summer">Samhradh</string>
    <string name="map_layer_season_autumn">Fómhar</string>
    <string name="map_layer_season_winter">Geimhreadh</string>
    <string name="map_layer_terrain_title">An saol mar thír-raon</string>
    <string name="map_layer_terrain_chip">Tír-raon</string>
    <string name="map_layer_terrain_description">Ardaítear dlús do shuímh go 3D: éiríonn na háiteanna a chaitheann tú an t-am is mó iontu ina miosaí arda lonracha, agus fanann áiteanna aonuaire íseal. Claon an léarscáil chun faoiseamh do shaoil a fheiceáil.</string>
    <string name="map_layer_terrain_low">Is annamh anseo</string>
    <string name="map_layer_terrain_mid">Uaireanta</string>
    <string name="map_layer_terrain_high">Go minic anseo</string>
    <string name="map_layer_places_title">Áiteanna minic</string>
    <string name="map_layer_places_chip">Áiteanna</string>
    <string name="map_layer_places_description">Do chuid áiteanna tábhachtacha mar mharcóirí, agus méid agus dath gach ceann ag brath ar mhinicíocht do chuairte. Éiríonn baile agus obair ina bponcanna móra te; fanann áit ar thug tú cuairt uirthi uair amháin beag agus fionnuar.</string>
    <string name="map_layer_places_rare">Go hannamh</string>
    <string name="map_layer_places_often">Uaireanta</string>
    <string name="map_layer_places_anchor">Do phríomháiteanna</string>
    <string name="map_layer_speed_ribbon_title">Ribín luais</string>
    <string name="map_layer_speed_ribbon_chip">Ribín</string>
    <string name="map_layer_speed_ribbon_description">Tá do bhealach péinteáilte de réir luas do ghluaiseachta, le dath ag sreabhadh ó shiúl mall corcra go rith tapa nó tiomáint dearg-the. Murab ionann agus an léarscáil teasa luais, coinníonn an ribín do chosán slán ionas go bhfeicfidh tú cá háit ar luasghéaraigh agus ar mhoilligh tú.</string>
    <string name="map_layer_altitude_ribbon_title" tools:ignore="MissingTranslation">Ribín airde</string>
    <string name="map_layer_altitude_ribbon_chip" tools:ignore="MissingTranslation">Airde</string>
    <string name="map_layer_altitude_ribbon_description" tools:ignore="MissingTranslation">Tá do bhealach péinteáilte de réir airde iomláine, ó ísealchríocha gorma dorcha trí bhun-sléibhte ciain go dtí airde te sléibhe. Fanann an scála seasta agus tú ag bogadh, mar sin coinníonn an airde chéanna an dath céanna i gcónaí.</string>
    <string name="map_layer_altitude_low" tools:ignore="MissingTranslation">Ísealchríocha</string>
    <string name="map_layer_altitude_mid" tools:ignore="MissingTranslation">Bun-sléibhte</string>
    <string name="map_layer_altitude_high" tools:ignore="MissingTranslation">Sléibhte arda</string>
    <string name="map_layer_activity_ribbon_title" tools:ignore="MissingTranslation">Ribín gníomhaíochta</string>
    <string name="map_layer_activity_ribbon_chip" tools:ignore="MissingTranslation">Gníomhaíocht</string>
    <string name="map_layer_activity_ribbon_description" tools:ignore="MissingTranslation">Tá do bhealach péinteáilte de réir staid iontaofa gluaiseachta a taifeadadh le gach ceartúchán: liath nuair nach raibh an staid ar eolas, gorm agus tú gan ghluaiseacht, agus glas agus tú ag gluaiseacht.</string>
    <string name="map_layer_activity_unknown" tools:ignore="MissingTranslation">Anaithnid</string>
    <string name="map_layer_activity_still" tools:ignore="MissingTranslation">Gan ghluaiseacht</string>
    <string name="map_layer_activity_moving" tools:ignore="MissingTranslation">Ag gluaiseacht</string>
    <string name="map_layer_ski_xray_title" tools:ignore="MissingTranslation">X-gha sciála</string>
    <string name="map_layer_ski_xray_chip" tools:ignore="MissingTranslation">X-gha sciála</string>
    <string name="map_layer_ski_xray_description" tools:ignore="MissingTranslation">Radharc diagnóiseach de chodanna sciála braite. Tá rithí síos an cnoc, ardaitheoirí, siúlóidí agus sosanna ceangailte leis an suíomh taifeadta is gaire agus lipéadaithe lena bpríomh-mhéadrachtaí.</string>
    <string name="map_layer_ski_downhill" tools:ignore="MissingTranslation">Rith síos an cnoc</string>
    <string name="map_layer_ski_lift" tools:ignore="MissingTranslation">Ardaitheoir</string>
    <string name="map_layer_ski_walk" tools:ignore="MissingTranslation">Siúl nó sos</string>
    <string name="map_layer_trip_constellations_title" tools:ignore="MissingTranslation">Réadbhuíonta turais</string>
    <string name="map_layer_trip_constellations_chip" tools:ignore="MissingTranslation">Turais</string>
    <string name="map_layer_trip_constellations_description" tools:ignore="MissingTranslation">Éiríonn turais athfhillteacha idir d’áiteanna minice ina réadbhuíonta cuartha. Taispeánann stua seasmhach gach bealach agus taistealaíonn cóiméad leis; ciallaíonn stuanna níos tibhe go ndearna tú an turas sin níos minice.</string>
    <string name="map_layer_trip_walk" tools:ignore="MissingTranslation">Ag siúl</string>
    <string name="map_layer_trip_bike" tools:ignore="MissingTranslation">Rothaíocht</string>
    <string name="map_layer_trip_car" tools:ignore="MissingTranslation">Tiomáint</string>
    <string name="map_layer_trip_transit" tools:ignore="MissingTranslation">Iompar poiblí</string>
    <string name="map_layer_trip_other" tools:ignore="MissingTranslation">Eile</string>
    <string name="map_layer_fog_title">Ceo an taiscéalaí</string>
    <string name="map_layer_fog_chip">Ceo</string>
    <string name="map_layer_fog_description">An domhan ag teacht amach as an gceo: nochtar gach limistéar ar bhain tú leis, agus lonraíonn sé níos gile dá mhéad aithne a chuir tú air. Fanann áiteanna nár rith tú ach tríothu mar cheo fann; dóann áit a ndearna tú taiscéaladh domhain uirthi in ór soladach. Fanann talamh gan taiscéaladh dorcha.</string>
    <string name="map_layer_fog_faint">Ritheadh tríd</string>
    <string name="map_layer_fog_known">Taiscéalaithe go maith</string>
    <string name="map_layer_first_contact_title">An chéad teagmháil</string>
    <string name="map_layer_first_contact_chip">Fionnachtain</string>
    <string name="map_layer_first_contact_description">Amlíne de do chuid fionnachtana: tá dath ar gach limistéar de réir cé chomh déanaí a leag tú cos ann den chéad uair. Téann áiteanna a fuair tú fadó i bhfiúis dhomhain, agus lonraíonn talamh nua na seachtaine seo i gcian geal — léigh scéal do thaiscéalaíochta amach go dtí na teorainneacha is nuaí.</string>
    <string name="map_layer_first_contact_old">Fadó</string>
    <string name="map_layer_first_contact_recent">Díreach aimsithe</string>
    <string name="map_layer_vehicle_compliance_title">Comhlíonadh luais feithicle</string>
    <string name="map_layer_vehicle_compliance_description">Polailíne de shamplaí tiomána atá daite de réir mar a chuirtear an luas i gcomparáid le do theorainn bhunlíne chumraithe.</string>
    <string name="map_layer_vehicle_compliance_way_under">I bhfad faoin teorainn</string>
