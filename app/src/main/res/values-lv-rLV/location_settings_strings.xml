    <string name="settings_all_day_location_title" tools:ignore="MissingTranslation">Atrašanās vieta visas dienas garumā</string>
    <string name="settings_all_day_location_off" tools:ignore="MissingTranslation">No sesijas līdz sesijām.</string>
    <string name="settings_all_day_location_saved" tools:ignore="MissingTranslation">Atbalsta starp sesijām. Atbalsts ir atkarīgs no piekļuves un Android.</string>
    <string name="settings_location_mode_adaptive" tools:ignore="MissingTranslation">Adaptīvs</string>
