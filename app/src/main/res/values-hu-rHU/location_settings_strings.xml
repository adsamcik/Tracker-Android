    <string name="settings_all_day_location_saved" tools:ignore="MissingTranslation">A találkozók között engedélyezett. A rendelkezésre állás függ a hozzáférésről és a Android háttérhatártól.</string>
    <string name="settings_location_mode_adaptive" tools:ignore="MissingTranslation">Adaptív</string>
