    <string name="settings_location_balance_5" tools:ignore="MissingTranslation">Először a részletek.</string>
    <string name="settings_location_motion_assistance" tools:ignore="MissingTranslation">A mozgalmi támogatás</string>
    <string name="settings_location_motion_assistance_summary" tools:ignore="MissingTranslation">A mozgásjelzéseket használhatja a helyiség beállításához. Ez nem rögzíti az Aktivitás előtérét, és nem kezdheti meg a sessziót. A helyszín még mindig működik, ha visszautasítod.</string>
