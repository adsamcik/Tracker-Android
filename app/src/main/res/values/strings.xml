    <!-- Auto-Tracking Setup Screen -->
    <string name="onboarding_auto_tracking_title">Auto-Tracking Setup</string>
    <string name="onboarding_auto_tracking_subtitle">Configure how Tracker monitors your activities automatically</string>
    <string name="onboarding_enable_auto_tracking">Enable Auto-Tracking</string>
    <string name="onboarding_auto_tracking_description">Automatically detect and log activities without manual intervention</string>
    <string name="onboarding_tracking_profile_title">Tracking Profile</string>
    <string name="onboarding_tracking_profile_subtitle">Choose how aggressively Tracker monitors your activities</string>
    <string name="tracking_profile_eco">ECO - Minimal battery usage</string>
    <string name="tracking_profile_eco_description">Best for battery life. Reduced accuracy and sampling frequency.</string>
    <string name="tracking_profile_balanced">BALANCED - Good accuracy with reasonable battery usage</string>
    <string name="tracking_profile_balanced_description">Balanced between accuracy and battery usage. Recommended for most users.</string>
    <string name="tracking_profile_precise">PRECISE - Maximum accuracy and detail</string>
    <string name="tracking_profile_precise_description">Highest accuracy and detail. Increased battery consumption.</string>
    <string name="auto_tracking_explanation">Auto-tracking uses device sensors and activity recognition to detect activities. All processing happens on your device.</string>
    <string name="onboarding_auto_tracking_more_title">Advanced auto-tracking options</string>
    <string name="onboarding_auto_tracking_more_subtitle">These map to Settings so you can fine-tune behavior later</string>
    <string name="onboarding_auto_tracking_transition_title">Use activity transitions</string>
    <string name="onboarding_auto_tracking_transition_summary">React to system-detected activity transitions when available</string>
    <string name="onboarding_activity_watcher_title">Enable periodic activity checks</string>
    <string name="onboarding_activity_watcher_summary">Occasionally check activity to improve detection when transitions miss</string>
    <string name="onboarding_pause_while_charging_title">Pause while charging</string>
    <string name="onboarding_pause_while_charging_summary">Disable auto-tracking when device is charging to save battery</string>

    <!-- Background Location Screen -->
    <string name="onboarding_bg_title">Background Location Tracking</string>
    <string name="onboarding_bg_enabled_title">Background Tracking Enabled!</string>
    <string name="onboarding_bg_subtitle">Enable automatic tracking when the app is in the background for seamless movement logging.</string>
    <string name="onboarding_bg_needs_location_subtitle">Location permission is required before enabling background tracking.</string>
    <string name="onboarding_bg_enabled_subtitle">Automatic tracking is now enabled. The app can track your movements even when minimized.</string>
