    <string name="onboarding_bg_benefit_automatic_desc">No need to manually start/stop tracking sessions</string>
    <string name="onboarding_bg_benefit_complete_title">Complete Journey Capture</string>
    <string name="onboarding_bg_benefit_complete_desc">Track entire trips even when switching between apps</string>
    <string name="onboarding_bg_benefit_insights_title">Better Insights</string>
    <string name="onboarding_bg_benefit_insights_desc">More complete data for better movement patterns</string>
    <string name="onboarding_bg_battery_title">Battery Usage</string>
    <string name="onboarding_bg_battery_desc">Background tracking uses more battery. The app is optimized to minimize impact, but you may notice increased battery usage.</string>
    <string name="onboarding_bg_privacy_title">Privacy Protected</string>
    <string name="onboarding_bg_privacy_desc">All location data remains on your device. We never upload or share your location information.</string>
    <string name="onboarding_bg_allow_cta">Allow Background Location</string>
    <string name="onboarding_bg_skip">Skip - Track manually</string>
    <string name="onboarding_bg_ready_title">Background tracking is ready!</string>
    <string name="onboarding_bg_ready_desc">The app will now automatically track your movements even when running in the background.</string>

    <!-- Privacy Screen -->
    <string name="onboarding_privacy_title">Privacy First</string>
    <string name="onboarding_privacy_subtitle">Your data, your control. We believe privacy is a fundamental right.</string>
    <string name="privacy_local_storage_title">Local Storage Only</string>
    <string name="privacy_local_storage_description">All your tracking data stays on your device. Nothing is uploaded to our servers.</string>
    <string name="privacy_no_cloud_title">No Cloud Sync</string>
    <string name="privacy_no_cloud_description">We don\'t collect, analyze, or share your personal movement patterns.</string>
    <string name="privacy_open_source_title">Open Source</string>
    <string name="privacy_open_source_description">Our code is transparent and auditable. You can verify exactly what we do.</string>
    <string name="privacy_your_control_title">Full Control</string>
    <string name="privacy_your_control_description">Export, delete, or modify your data anytime. You own it completely.</string>
    <string name="privacy_data_storage_preferences">Data Storage Preferences</string>
    <string name="privacy_auto_cleanup_title">Auto-cleanup old data</string>
    <string name="privacy_auto_cleanup_description">Automatically remove data older than 1 year</string>
    <string name="privacy_export_reminder">You can export your data anytime from the settings menu</string>
