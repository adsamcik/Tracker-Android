    <string name="setup_what_to_collect_subtitle">Další možnosti jsou níže. Začněte objevovat bez oprávnění nebo je povolte později. Data zůstávají v tomto zařízení.</string>
    <string name="setup_source_location">Poloha</string>
    <string name="setup_source_location_desc">Zaznamenávejte své trasy a polohy na mapě.</string>
    <string name="setup_source_activity">Aktivita</string>
    <string name="setup_source_activity_desc">Zjistěte, zda jdete, běžíte, jedete na kole nebo řídíte.</string>
    <string name="setup_source_steps">Kroky</string>
