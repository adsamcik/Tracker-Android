    <string name="setup_what_to_collect_subtitle">Lisää vaihtoehtoja alla. Aloita tutkiminen ilman käyttöoikeuksia tai myönnä ne myöhemmin. Tiedot pysyvät tällä laitteella.</string>
    <string name="setup_source_location">Sijainti</string>
    <string name="setup_source_location_desc">Tallenna reittisi ja sijaintisi kartalle.</string>
    <string name="setup_source_activity">Aktiivisuus</string>
    <string name="setup_source_activity_desc">Tunnista, käveletkö, juoksetko, pyöräiletkö vai ajatko.</string>
