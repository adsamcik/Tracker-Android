    <string name="settings_all_day_location_title" tools:ignore="MissingTranslation">Plats hela dagen</string>
    <string name="settings_all_day_location_off" tools:ignore="MissingTranslation">Av mellan sessionerna.</string>
    <string name="settings_all_day_location_saved" tools:ignore="MissingTranslation">Aktiverad mellan sessionerna. Tillgängligheten beror på tillgång och Android-gränser.</string>
    <string name="settings_location_mode_adaptive" tools:ignore="MissingTranslation">Anpassningsbara</string>
