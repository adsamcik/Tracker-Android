    <string name="settings_location_adopt_profile" tools:ignore="MissingTranslation">Välj adaptiv läge detaljer</string>
    <string name="settings_location_balance_value" tools:ignore="MissingTranslation">Platsuppgifter: %1$s</string>
    <string name="settings_location_balance_title" tools:ignore="MissingTranslation">Platsstyrka och detaljer</string>
    <string name="settings_location_balance_summary" tools:ignore="MissingTranslation">Välj en nivå för att anta adaptiv plats. Balancerad är standard; Live-sessions föredrar mer detaljer. Android och din tillgång kan begränsa resultatet.</string>
    <string name="settings_location_balance_1" tools:ignore="MissingTranslation">Ström först</string>
